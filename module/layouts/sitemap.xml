{{- /* HTML renders register pages; defer until every language has finished. */ -}}
{{- /* shortcut: fast previews may retain this output; use --disableFastRender when checking sitemap changes. */ -}}
{{- $data := dict "site" .Site -}}
{{- with (templates.Defer (dict "data" $data)) -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pages := partial "system-metadata/sitemap/pages.html" .site -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range $pages }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .AllTranslations }}{{ if partial "system-metadata/sitemap/eligible.html" . }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" />{{ end }}{{ end }}{{ end }}
  </url>
  {{ end }}
</urlset>
{{- end -}}
