import { createServiceWorkerManagerRuntime } from './manager-runtime.js';
import { startEnableMode } from './update-engine.js';
import { initUpdateNavigation } from './navigation.js';

const runtime = createServiceWorkerManagerRuntime({
    swUrl: {{ printf "%q" .sw_url }},
    swScope: '/'
});

runtime.updates = startEnableMode(runtime);
initUpdateNavigation(runtime);
