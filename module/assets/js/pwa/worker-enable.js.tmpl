import {
    FINGERPRINT_ASSET_CACHE,
    CONTENT_STATE_CACHE,
    PROGRAM_OFFLINE_CACHE_PREFIX,
    NAVIGATION_CACHE_PREFIX,
    VERSIONED_ASSET_CACHE_PREFIX,
    shouldDeleteVersionedCache,
} from './cache-names.js';
const CONTENT_VERSION_URL = new URL({{ .version_url | jsonify }}, self.location.origin).href;
const CONTENT_CHECK_INTERVAL_MS = {{ .content_check_interval_ms }};
const CONTENT_CHECK_DELAY_MS = 15000;
const CONTENT_CHECK_TIMEOUT_MS = 10000;
const PROGRAM_OFFLINE_CACHE = PROGRAM_OFFLINE_CACHE_PREFIX + '__BANYAN_SW_PROGRAM_HASH__';
const OFFLINE_FALLBACKS = {{ .offline_fallbacks | jsonify }};
const SW_ROUTES = {{ .sw_routes | jsonify }};
let currentGeneration = null;
let generationPromise = null;
let lastAttemptAt = 0;
let contentCheckTask = null;
let contentCheckController = null;
let contentCheckTimer = null;
let contentCheckDelayResolve = null;
let contentCheckCancelled = false;
const HTML_ASSET_ATTR_PATTERN = /\b(?:href|src)\s*=\s*(?:"([^"]+)"|'([^']+)'|([^\s"'=<>`]+))/ig;

function isSameOriginRequest(request) {
    try {
        return new URL(request.url).origin === self.location.origin;
    } catch (error) {
        return false;
    }
}

function acceptsHtmlDocument(request) {
    try {
        const accept = request.headers.get('accept') || '';
        return accept.includes('text/html');
    } catch (error) {
        return false;
    }
}

function isHtmlDocumentRequest(request) {
    if (request.method !== 'GET') return false;
    if (!isSameOriginRequest(request)) return false;
    if (request.mode === 'navigate') return true;
    if (request.destination === 'document') return true;
    return acceptsHtmlDocument(request);
}

function isCacheableHtmlResponse(response) {
    return response && response.ok && response.headers.get('content-type')?.includes('text/html');
}

function isCacheableAssetResponse(response) {
    return response && response.ok;
}

function getRequestPathname(request) {
    try {
        return new URL(request.url).pathname;
    } catch (error) {
        return '';
    }
}

function isEligibleAssetRequest(request) {
    if (request.method !== 'GET') return false;
    if (!isSameOriginRequest(request)) return false;
    if (isHtmlDocumentRequest(request)) return false;
    return true;
}

function matchesRoutePath(routePath, pathname) {
    if (!routePath || !pathname) return false;
    const wildcard = routePath.indexOf('*');
    if (wildcard === -1) return pathname === routePath;
    return pathname.length >= routePath.length - 1
        && pathname.startsWith(routePath.slice(0, wildcard))
        && pathname.endsWith(routePath.slice(wildcard + 1));
}

function getMatchingRoute(pathname) {
    for (const route of SW_ROUTES) {
        if (matchesRoutePath(route.path, pathname)) {
            return route;
        }
    }

    return null;
}

function shouldHandleRoute(route) {
    return route && (route.bucket === 'versioned' || route.bucket === 'fingerprinted');
}

function getCacheNameForRoute(route, navigation = false, version = currentGeneration?.version) {
    if (!route) return '';
    if (route.bucket === 'fingerprinted') return FINGERPRINT_ASSET_CACHE;
    if (route.bucket === 'versioned') {
        if (!isValidContentVersion(version)) return '';
        return (navigation ? NAVIGATION_CACHE_PREFIX : VERSIONED_ASSET_CACHE_PREFIX) + version;
    }
    return '';
}

function isValidContentVersion(version) {
    return typeof version === 'string' && version.length > 0 && version.length <= 128
        && version.trim() === version && !/[\u0000-\u001f\u007f]/.test(version);
}

async function readContentState() {
    const cache = await caches.open(CONTENT_STATE_CACHE);
    const response = await cache.match(CONTENT_VERSION_URL);
    if (!response) return null;
    try {
        const state = await response.json();
        return state && typeof state === 'object' ? state : null;
    } catch (error) {
        return null;
    }
}

async function saveContentState(version, attemptedAt) {
    const cache = await caches.open(CONTENT_STATE_CACHE);
    await cache.put(CONTENT_VERSION_URL, new Response(JSON.stringify({
        version,
        lastAttemptAt: attemptedAt,
    }), { headers: { 'Content-Type': 'application/json' } }));
}

async function openGeneration(version) {
    const [navigationCache, assetCache] = await Promise.all([
        caches.open(NAVIGATION_CACHE_PREFIX + version),
        caches.open(VERSIONED_ASSET_CACHE_PREFIX + version),
    ]);
    return { version, navigationCache, assetCache, warmupTasks: new Map() };
}

async function cleanupVersionedCaches(generation) {
    const keys = await caches.keys();
    await Promise.all(keys.filter((key) => shouldDeleteVersionedCache(key,
        NAVIGATION_CACHE_PREFIX + generation.version,
        VERSIONED_ASSET_CACHE_PREFIX + generation.version
    )).map((key) => caches.delete(key)));
}

function getCurrentGeneration() {
    if (!generationPromise) {
        generationPromise = (async () => {
            const state = await readContentState();
            lastAttemptAt = Number.isFinite(state?.lastAttemptAt) && state.lastAttemptAt > 0
                ? state.lastAttemptAt : 0;
            currentGeneration = isValidContentVersion(state?.version)
                ? await openGeneration(state.version) : null;
            if (currentGeneration) {
                await cleanupVersionedCaches(currentGeneration).catch(() => { });
            }
            return currentGeneration;
        })().catch((error) => {
            generationPromise = null;
            throw error;
        });
    }
    return generationPromise;
}

async function getCacheForRoute(route, generation, navigation = false) {
    if (route.bucket === 'fingerprinted') return caches.open(FINGERPRINT_ASSET_CACHE);
    if (!generation) return null;
    return navigation ? generation.navigationCache : generation.assetCache;
}

async function fetchCacheResponse(request, route, signal) {
    // A fresh versioned SW cache must not be populated from an older HTTP cache.
    let response = await fetch(route.bucket === 'versioned'
        ? new Request(request, { cache: 'no-cache', signal })
        : signal ? new Request(request, { signal }) : request);
    if (response && response.status === 304) {
        // Cache Storage needs a full body, including after browser prefetch validation.
        response = await fetch(new Request(request, { cache: 'reload', signal }));
    }
    return response;
}

function normalizeSameOriginUrl(urlValue, baseUrl) {
    try {
        const url = new URL(urlValue, baseUrl || self.location.origin);
        if (url.origin !== self.location.origin) return '';
        url.hash = '';
        return url.toString();
    } catch (error) {
        return '';
    }
}

function createNavigationCacheKeyRequest(request) {
    if (!request) return null;

    const normalizedUrl = normalizeSameOriginUrl(request.url, self.location.origin);
    if (!normalizedUrl) return request;

    return new Request(normalizedUrl, {
        credentials: 'same-origin',
        headers: {
            Accept: 'text/html'
        }
    });
}

function normalizePathnameForPrefixMatch(pathname) {
    if (typeof pathname !== 'string' || !pathname) return '/';
    if (pathname === '/') return '/';
    return pathname.endsWith('/') ? pathname : pathname + '/';
}

function getOfflineFallbackUrl(pathname) {
    const normalizedPathname = normalizePathnameForPrefixMatch(pathname);
    let matchedUrl = '';
    let matchedPrefixLength = -1;

    for (const fallback of OFFLINE_FALLBACKS) {
        if (!fallback || typeof fallback !== 'object') continue;

        const normalizedPrefix = normalizePathnameForPrefixMatch(
            typeof fallback.path_prefix === 'string' ? fallback.path_prefix : ''
        );
        const normalizedUrl = normalizeSameOriginUrl(fallback.url);

        if (!normalizedPrefix || !normalizedUrl) continue;
        if (!normalizedPathname.startsWith(normalizedPrefix)) continue;
        if (normalizedPrefix.length <= matchedPrefixLength) continue;

        matchedUrl = normalizedUrl;
        matchedPrefixLength = normalizedPrefix.length;
    }

    return matchedUrl;
}

function getOfflineFallbackUrls() {
    const urls = [];
    const seenUrls = new Set();

    for (const fallback of OFFLINE_FALLBACKS) {
        if (!fallback || typeof fallback !== 'object') continue;
        const normalizedUrl = normalizeSameOriginUrl(fallback.url);
        if (!normalizedUrl || seenUrls.has(normalizedUrl)) continue;
        seenUrls.add(normalizedUrl);
        urls.push(normalizedUrl);
    }

    return urls.filter((url) => shouldHandleRoute(getMatchingRoute(new URL(url).pathname)));
}

function getAssetUrlsFromHtml(htmlText, baseUrl) {
    if (typeof htmlText !== 'string' || !htmlText) return [];

    const urls = [];
    const seenUrls = new Set();
    HTML_ASSET_ATTR_PATTERN.lastIndex = 0;

    let match = null;
    while ((match = HTML_ASSET_ATTR_PATTERN.exec(htmlText))) {
        const rawUrl = match[1] || match[2] || match[3] || '';
        const normalizedUrl = normalizeSameOriginUrl(rawUrl, baseUrl);
        if (!normalizedUrl || seenUrls.has(normalizedUrl)) continue;

        const pathname = getRequestPathname(new Request(normalizedUrl));
        const route = getMatchingRoute(pathname);
        // A catch-all versioned rule must not turn page links into asset warmups.
        if (route?.bucket !== 'fingerprinted') continue;

        seenUrls.add(normalizedUrl);
        urls.push(normalizedUrl);
    }

    return urls;
}

async function warmAssetsFromHtmlResponse(response, baseUrl, signal) {
    if (!isCacheableHtmlResponse(response)) return false;

    try {
        const htmlText = await response.text();
        const assetUrls = getAssetUrlsFromHtml(htmlText, baseUrl);
        const results = await Promise.all(assetUrls.map((assetUrl) => warmAssetUrl(assetUrl, signal)));
        return results.every(Boolean);
    } catch (error) {
        return false;
    }
}

async function updateNavigationCache(request, cache, route, waitForAssetWarmup = false, signal) {
    try {
        const cacheKeyRequest = createNavigationCacheKeyRequest(request);
        const response = await fetchCacheResponse(request, route, signal);
        if (isCacheableHtmlResponse(response)) {
            await cache.put(cacheKeyRequest || request, response.clone());
            const assetWarmupTask = warmAssetsFromHtmlResponse(response.clone(), response.url || request.url, signal);
            if (waitForAssetWarmup) {
                if (!await assetWarmupTask) return null;
            } else {
                assetWarmupTask.catch(() => { });
            }
        }
        return response;
    } catch (error) {
        return null;
    }
}

async function updateAssetCache(request, cache, route, signal) {
    try {
        const response = await fetchCacheResponse(request, route, signal);
        if (isCacheableAssetResponse(response)) {
            await cache.put(request, response.clone());
        }
        return response;
    } catch (error) {
        return null;
    }
}

async function getOfflineFallbackResponse(pathname, generation) {
    const offlineUrl = getOfflineFallbackUrl(pathname);
    if (!offlineUrl) return null;

    const offlineRequest = new Request(offlineUrl, {
        credentials: 'same-origin',
        headers: {
            Accept: 'text/html'
        }
    });
    const route = getMatchingRoute(getRequestPathname(offlineRequest));
    if (!shouldHandleRoute(route)) return null;
    const cache = await getCacheForRoute(route, generation, true);
    if (!cache) return null;
    const cachedResponse = await cache.match(createNavigationCacheKeyRequest(offlineRequest) || offlineRequest);
    if (cachedResponse) {
        return cachedResponse;
    }

    const networkResponse = await updateNavigationCache(offlineRequest, cache, route, true);
    if (isCacheableHtmlResponse(networkResponse)) {
        return networkResponse;
    }

    return null;
}

async function warmAssetUrl(urlValue, signal) {
    const href = normalizeSameOriginUrl(urlValue, self.location.origin);
    if (!href) return false;

    const pathname = getRequestPathname(new Request(href));
    const route = getMatchingRoute(pathname);
    if (route?.bucket !== 'fingerprinted') return false;

    const cacheName = getCacheNameForRoute(route);
    if (!cacheName) return false;

    const cache = await caches.open(cacheName);
    const request = new Request(href, {
        credentials: 'same-origin'
    });
    const cachedResponse = await cache.match(request);
    if (cachedResponse) return true;

    return isCacheableAssetResponse(await updateAssetCache(request, cache, route, signal));
}

async function warmNavigationUrl(urlValue, generation, signal) {
    const href = normalizeSameOriginUrl(urlValue);
    if (!href) return false;
    const pathname = getRequestPathname(new Request(href));
    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) return false;

    if (generation === undefined) generation = await getCurrentGeneration();
    if (!generation) return false;

    if (generation.warmupTasks.has(href)) {
        return generation.warmupTasks.get(href);
    }

    const task = (async () => {
        const cache = await getCacheForRoute(route, generation, true);
        const request = new Request(href, {
            credentials: 'same-origin',
            headers: {
                Accept: 'text/html'
            }
        });
        const cacheKeyRequest = createNavigationCacheKeyRequest(request);
        const cachedResponse = await cache.match(cacheKeyRequest || request);
        if (cachedResponse) {
            return warmAssetsFromHtmlResponse(cachedResponse.clone(), href, signal);
        }
        return isCacheableHtmlResponse(await updateNavigationCache(request, cache, route, true, signal));
    })();

    generation.warmupTasks.set(href, task);
    try {
        return await task;
    } finally {
        generation.warmupTasks.delete(href);
    }
}

async function warmNavigationUrls(urlValues, generation, signal) {
    let warmed = true;
    for (const urlValue of urlValues) {
        if (!await warmNavigationUrl(urlValue, generation, signal)) warmed = false;
    }
    return warmed;
}

async function handleNavigationRequest(request) {
    const pathname = getRequestPathname(request);
    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) {
        return fetch(request);
    }

    const generation = await getCurrentGeneration();
    const cache = await getCacheForRoute(route, generation, true);
    if (!cache) return fetchCacheResponse(request, route);
    const cacheKeyRequest = createNavigationCacheKeyRequest(request);
    const cachedResponse = await cache.match(cacheKeyRequest || request);
    if (cachedResponse) {
        return cachedResponse;
    }

    const networkResponse = await updateNavigationCache(request, cache, route);
    if (networkResponse) {
        return networkResponse;
    }

    const offlineFallbackResponse = await getOfflineFallbackResponse(pathname, generation);
    if (offlineFallbackResponse) {
        return offlineFallbackResponse;
    }

    throw new Error('Navigation request failed with no cached response.');
}

async function handleAssetRequest(request, pathname) {
    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) {
        return fetch(request);
    }

    const generation = await getCurrentGeneration();
    const cache = await getCacheForRoute(route, generation);
    if (!cache) return fetchCacheResponse(request, route);
    const cachedResponse = await cache.match(request);
    if (cachedResponse) {
        return cachedResponse;
    }

    const networkResponse = await updateAssetCache(request, cache, route);
    if (networkResponse) {
        return networkResponse;
    }

    throw new Error('Asset request failed with no network response.');
}

async function fetchContentVersion(signal) {
    const response = await fetch(CONTENT_VERSION_URL, {
        cache: 'no-store',
        credentials: 'same-origin',
        signal,
    });
    if (!response.ok) throw new Error('Content version request failed.');
    const data = await response.json();
    if (!isValidContentVersion(data?.version)) throw new Error('Invalid content version.');
    return data.version;
}

async function refreshContentVersion(signal) {
    const generation = await getCurrentGeneration();
    if (signal.aborted) throw new Error('Content version check cancelled.');

    lastAttemptAt = Date.now();
    await saveContentState(generation?.version || '', lastAttemptAt);
    if (signal.aborted) throw new Error('Content version check cancelled.');

    const version = await fetchContentVersion(signal);

    let committed = generation?.version === version;
    try {
        const candidate = committed ? { ...generation, warmupTasks: new Map() } : await openGeneration(version);
        const offlineUrls = getOfflineFallbackUrls();
        if (!await warmNavigationUrls(offlineUrls, candidate, signal)) {
            throw new Error('Content offline fallback preparation failed.');
        }
        if (signal.aborted) throw new Error('Content version check cancelled.');

        if (!committed) {
            // After preparation, publishing the generation must finish even if cancellation arrives.
            await saveContentState(candidate.version, lastAttemptAt);
            currentGeneration = candidate;
            generationPromise = Promise.resolve(candidate);
            committed = true;
        }
        await cleanupVersionedCaches(candidate);
    } finally {
        if (!committed) {
            await Promise.all([
                caches.delete(NAVIGATION_CACHE_PREFIX + version),
                caches.delete(VERSIONED_ASSET_CACHE_PREFIX + version),
            ]).catch(() => { });
        }
    }
}

async function prepareProgramOffline(signal) {
    await caches.delete(PROGRAM_OFFLINE_CACHE);
    // Initial page warmup can arrive during activation, so publish its content state during install.
    if (!self.registration.active) return refreshContentVersion(signal);
    try {
        const cache = await caches.open(PROGRAM_OFFLINE_CACHE);
        const state = await readContentState();
        if (signal.aborted) throw new Error('Program offline fallback preparation cancelled.');
        if (!isValidContentVersion(state?.version)) {
            const attemptedAt = Date.now();
            const version = await fetchContentVersion(signal);
            await cache.put(CONTENT_VERSION_URL, new Response(JSON.stringify({
                version,
                lastAttemptAt: attemptedAt,
            }), { headers: { 'Content-Type': 'application/json' } }));
        }
        const generation = { navigationCache: cache, warmupTasks: new Map() };
        if (!await warmNavigationUrls(getOfflineFallbackUrls(), generation, signal) || signal.aborted) {
            throw new Error('Program offline fallback preparation failed.');
        }
    } catch (error) {
        await caches.delete(PROGRAM_OFFLINE_CACHE).catch(() => { });
        throw error;
    }
}

async function restoreProgramOffline(generation) {
    if (!(await caches.keys()).includes(PROGRAM_OFFLINE_CACHE)) return;
    const cache = await caches.open(PROGRAM_OFFLINE_CACHE);
    let bootstrapState;
    if (!generation) {
        const response = await cache.match(CONTENT_VERSION_URL);
        bootstrapState = response ? await response.json() : null;
        if (!isValidContentVersion(bootstrapState?.version)) throw new Error('Program activation needs a content version.');
        generation = await openGeneration(bootstrapState.version);
    }
    const pages = await Promise.all(getOfflineFallbackUrls().filter((url) =>
        getMatchingRoute(new URL(url).pathname).bucket === 'versioned').map(async (url) => {
        const request = createNavigationCacheKeyRequest(new Request(url));
        const response = await cache.match(request);
        if (!isCacheableHtmlResponse(response)) throw new Error('Prepared program offline fallback is missing.');
        return { request, response };
    }));
    for (const { request, response } of pages) await generation.navigationCache.put(request, response);
    if (bootstrapState) {
        lastAttemptAt = Number.isFinite(bootstrapState.lastAttemptAt) && bootstrapState.lastAttemptAt > 0
            ? bootstrapState.lastAttemptAt : 0;
        await saveContentState(generation.version, lastAttemptAt);
        currentGeneration = generation;
        generationPromise = Promise.resolve(generation);
        await cleanupVersionedCaches(generation);
    }
    // shortcut: replaced waiting stages persist until disable; add GC if program replacements become frequent.
    await caches.delete(PROGRAM_OFFLINE_CACHE);
}

async function runCachePreparation(prepare) {
    const controller = new AbortController();
    contentCheckController = controller;
    const timeout = setTimeout(() => controller.abort(), CONTENT_CHECK_TIMEOUT_MS);
    try {
        await prepare(controller.signal);
    } finally {
        controller.abort();
        clearTimeout(timeout);
        if (contentCheckController === controller) contentCheckController = null;
    }
}

function cancelContentVersionCheck() {
    contentCheckCancelled = true;
    if (contentCheckTimer !== null) {
        clearTimeout(contentCheckTimer);
        contentCheckTimer = null;
    }
    const resolve = contentCheckDelayResolve;
    contentCheckDelayResolve = null;
    if (resolve) resolve(false);
    contentCheckController?.abort();
}

function scheduleContentVersionCheck() {
    if (contentCheckTask) return contentCheckTask;
    if (self.registration.installing || self.registration.waiting) return Promise.resolve();

    contentCheckCancelled = false;
    contentCheckTask = (async () => {
        await getCurrentGeneration();
        const elapsed = Date.now() - lastAttemptAt;
        if (lastAttemptAt > 0 && elapsed >= 0 && elapsed < CONTENT_CHECK_INTERVAL_MS) return;
        if (contentCheckCancelled || self.registration.installing || self.registration.waiting) return;

        const delayed = await new Promise((resolve) => {
            contentCheckDelayResolve = resolve;
            contentCheckTimer = setTimeout(() => {
                contentCheckTimer = null;
                contentCheckDelayResolve = null;
                resolve(true);
            }, CONTENT_CHECK_DELAY_MS);
        });
        if (!delayed || contentCheckCancelled || self.registration.installing || self.registration.waiting) return;
        await runCachePreparation(refreshContentVersion);
    })().catch(() => { }).finally(() => {
        contentCheckTask = null;
    });
    return contentCheckTask;
}

self.registration.addEventListener('updatefound', cancelContentVersionCheck);

self.addEventListener('install', (event) => {
    // An active program may still commit a version; stage its replacement without publishing content state.
    event.waitUntil(runCachePreparation(prepareProgramOffline));
});

self.addEventListener('activate', (event) => {
    event.waitUntil((async () => {
        if (self.registration.navigationPreload) {
            // Navigation caching is cache-first, so global navigation preload only creates
            // extra network work and Chrome warnings when cached HTML wins.
            await self.registration.navigationPreload.disable();
        }
        currentGeneration = null;
        generationPromise = null;
        lastAttemptAt = 0;
        await restoreProgramOffline(await getCurrentGeneration());
        await self.clients.claim();
    })());
});

self.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'SKIP_WAITING') {
        self.skipWaiting();
        return;
    }

    if (event.data && event.data.type === 'WARM_NAV_BATCH' && Array.isArray(event.data.urls)) {
        event.waitUntil(warmNavigationUrls(event.data.urls));
    }
});

self.addEventListener('fetch', (event) => {
    const { request } = event;
    const pathname = getRequestPathname(request);
    if (!pathname) return;

    if (isHtmlDocumentRequest(request)) {
        const route = getMatchingRoute(pathname);
        if (!shouldHandleRoute(route)) return;

        const responsePromise = handleNavigationRequest(request);
        event.respondWith(responsePromise);
        if (request.mode === 'navigate') {
            event.waitUntil(responsePromise.then((response) => {
                if (isCacheableHtmlResponse(response)) return scheduleContentVersionCheck();
            }).catch(() => { }));
        }
        return;
    }

    if (!isEligibleAssetRequest(request)) return;

    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) return;

    event.respondWith((async () => {
        try {
            return await handleAssetRequest(request, pathname);
        } catch (error) {
            return fetch(request);
        }
    })());
});
