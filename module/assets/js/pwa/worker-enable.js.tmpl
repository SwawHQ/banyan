import {
    FINGERPRINT_ASSET_CACHE,
    NAVIGATION_CACHE_PREFIX,
    VERSIONED_ASSET_CACHE_PREFIX,
    shouldDeleteVersionedCache,
} from './cache-names.js';
const NAVIGATION_CACHE = NAVIGATION_CACHE_PREFIX + '{{ .build_version }}';
const VERSIONED_ASSET_CACHE = VERSIONED_ASSET_CACHE_PREFIX + '{{ .build_version }}';
const OFFLINE_FALLBACKS = {{ .offline_fallbacks | jsonify }};
const SW_ROUTES = {{ .sw_routes | jsonify }};
const navigationWarmupTasks = new Map();
const HTML_ASSET_ATTR_PATTERN = /\b(?:href|src)\s*=\s*(?:"([^"]+)"|'([^']+)'|([^\s"'=<>`]+))/ig;

function isSameOriginRequest(request) {
    try {
        return new URL(request.url).origin === self.location.origin;
    } catch (error) {
        return false;
    }
}

function acceptsHtmlDocument(request) {
    try {
        const accept = request.headers.get('accept') || '';
        return accept.includes('text/html');
    } catch (error) {
        return false;
    }
}

function isHtmlDocumentRequest(request) {
    if (request.method !== 'GET') return false;
    if (!isSameOriginRequest(request)) return false;
    if (request.mode === 'navigate') return true;
    if (request.destination === 'document') return true;
    return acceptsHtmlDocument(request);
}

function isCacheableHtmlResponse(response) {
    return response && response.ok && response.headers.get('content-type')?.includes('text/html');
}

function isCacheableAssetResponse(response) {
    return response && response.ok;
}

function getRequestPathname(request) {
    try {
        return new URL(request.url).pathname;
    } catch (error) {
        return '';
    }
}

function isEligibleAssetRequest(request) {
    if (request.method !== 'GET') return false;
    if (!isSameOriginRequest(request)) return false;
    if (isHtmlDocumentRequest(request)) return false;
    return true;
}

function matchesRoutePath(routePath, pathname) {
    if (!routePath || !pathname) return false;
    const wildcard = routePath.indexOf('*');
    if (wildcard === -1) return pathname === routePath;
    return pathname.length >= routePath.length - 1
        && pathname.startsWith(routePath.slice(0, wildcard))
        && pathname.endsWith(routePath.slice(wildcard + 1));
}

function getMatchingRoute(pathname) {
    for (const route of SW_ROUTES) {
        if (matchesRoutePath(route.path, pathname)) {
            return route;
        }
    }

    return null;
}

function shouldHandleRoute(route) {
    return route && (route.bucket === 'versioned' || route.bucket === 'fingerprinted');
}

function getCacheNameForRoute(route, navigation = false) {
    if (!route) return '';
    if (route.bucket === 'fingerprinted') return FINGERPRINT_ASSET_CACHE;
    if (route.bucket === 'versioned') {
        return navigation ? NAVIGATION_CACHE : VERSIONED_ASSET_CACHE;
    }
    return '';
}

function shouldDeleteOnActivate(key) {
    return shouldDeleteVersionedCache(key, NAVIGATION_CACHE, VERSIONED_ASSET_CACHE);
}

async function fetchCacheResponse(request, route) {
    // A fresh versioned SW cache must not be populated from an older HTTP cache.
    let response = await fetch(route.bucket === 'versioned'
        ? new Request(request, { cache: 'no-cache' }) : request);
    if (response && response.status === 304) {
        // Cache Storage needs a full body, including after browser prefetch validation.
        response = await fetch(new Request(request, { cache: 'reload' }));
    }
    return response;
}

function normalizeSameOriginUrl(urlValue, baseUrl) {
    try {
        const url = new URL(urlValue, baseUrl || self.location.origin);
        if (url.origin !== self.location.origin) return '';
        url.hash = '';
        return url.toString();
    } catch (error) {
        return '';
    }
}

function createNavigationCacheKeyRequest(request) {
    if (!request) return null;

    const normalizedUrl = normalizeSameOriginUrl(request.url, self.location.origin);
    if (!normalizedUrl) return request;

    return new Request(normalizedUrl, {
        credentials: 'same-origin',
        headers: {
            Accept: 'text/html'
        }
    });
}

function normalizePathnameForPrefixMatch(pathname) {
    if (typeof pathname !== 'string' || !pathname) return '/';
    if (pathname === '/') return '/';
    return pathname.endsWith('/') ? pathname : pathname + '/';
}

function getOfflineFallbackUrl(pathname) {
    const normalizedPathname = normalizePathnameForPrefixMatch(pathname);
    let matchedUrl = '';
    let matchedPrefixLength = -1;

    for (const fallback of OFFLINE_FALLBACKS) {
        if (!fallback || typeof fallback !== 'object') continue;

        const normalizedPrefix = normalizePathnameForPrefixMatch(
            typeof fallback.path_prefix === 'string' ? fallback.path_prefix : ''
        );
        const normalizedUrl = normalizeSameOriginUrl(fallback.url);

        if (!normalizedPrefix || !normalizedUrl) continue;
        if (!normalizedPathname.startsWith(normalizedPrefix)) continue;
        if (normalizedPrefix.length <= matchedPrefixLength) continue;

        matchedUrl = normalizedUrl;
        matchedPrefixLength = normalizedPrefix.length;
    }

    return matchedUrl;
}

function getOfflineFallbackUrls() {
    const urls = [];
    const seenUrls = new Set();

    for (const fallback of OFFLINE_FALLBACKS) {
        if (!fallback || typeof fallback !== 'object') continue;
        const normalizedUrl = normalizeSameOriginUrl(fallback.url);
        if (!normalizedUrl || seenUrls.has(normalizedUrl)) continue;
        seenUrls.add(normalizedUrl);
        urls.push(normalizedUrl);
    }

    return urls;
}

function getAssetUrlsFromHtml(htmlText, baseUrl) {
    if (typeof htmlText !== 'string' || !htmlText) return [];

    const urls = [];
    const seenUrls = new Set();
    HTML_ASSET_ATTR_PATTERN.lastIndex = 0;

    let match = null;
    while ((match = HTML_ASSET_ATTR_PATTERN.exec(htmlText))) {
        const rawUrl = match[1] || match[2] || match[3] || '';
        const normalizedUrl = normalizeSameOriginUrl(rawUrl, baseUrl);
        if (!normalizedUrl || seenUrls.has(normalizedUrl)) continue;

        const pathname = getRequestPathname(new Request(normalizedUrl));
        const route = getMatchingRoute(pathname);
        // A catch-all versioned rule must not turn page links into asset warmups.
        if (route?.bucket !== 'fingerprinted') continue;

        seenUrls.add(normalizedUrl);
        urls.push(normalizedUrl);
    }

    return urls;
}

async function warmAssetsFromHtmlResponse(response, baseUrl) {
    if (!isCacheableHtmlResponse(response)) return;

    try {
        const htmlText = await response.text();
        const assetUrls = getAssetUrlsFromHtml(htmlText, baseUrl);
        await Promise.all(assetUrls.map((assetUrl) => warmAssetUrl(assetUrl)));
    } catch (error) { }
}

async function updateNavigationCache(request, cache, route, waitForAssetWarmup = false) {
    try {
        const cacheKeyRequest = createNavigationCacheKeyRequest(request);
        const response = await fetchCacheResponse(request, route);
        if (isCacheableHtmlResponse(response)) {
            await cache.put(cacheKeyRequest || request, response.clone());
            const assetWarmupTask = warmAssetsFromHtmlResponse(response.clone(), response.url || request.url);
            if (waitForAssetWarmup) {
                await assetWarmupTask;
            } else {
                assetWarmupTask.catch(() => { });
            }
        }
        return response;
    } catch (error) {
        return null;
    }
}

async function updateAssetCache(request, cache, route) {
    try {
        const response = await fetchCacheResponse(request, route);
        if (isCacheableAssetResponse(response)) {
            await cache.put(request, response.clone());
        }
        return response;
    } catch (error) {
        return null;
    }
}

async function getOfflineFallbackResponse(pathname) {
    const offlineUrl = getOfflineFallbackUrl(pathname);
    if (!offlineUrl) return null;

    const offlineRequest = new Request(offlineUrl, {
        credentials: 'same-origin',
        headers: {
            Accept: 'text/html'
        }
    });
    const route = getMatchingRoute(getRequestPathname(offlineRequest));
    if (!shouldHandleRoute(route)) return null;
    const cache = await caches.open(getCacheNameForRoute(route, true));
    const cachedResponse = await cache.match(createNavigationCacheKeyRequest(offlineRequest) || offlineRequest);
    if (cachedResponse) {
        return cachedResponse;
    }

    const networkResponse = await updateNavigationCache(offlineRequest, cache, route, true);
    if (isCacheableHtmlResponse(networkResponse)) {
        return networkResponse;
    }

    return null;
}

async function warmAssetUrl(urlValue) {
    const href = normalizeSameOriginUrl(urlValue, self.location.origin);
    if (!href) return;

    const pathname = getRequestPathname(new Request(href));
    const route = getMatchingRoute(pathname);
    if (route?.bucket !== 'fingerprinted') return;

    const cacheName = getCacheNameForRoute(route);
    if (!cacheName) return;

    const cache = await caches.open(cacheName);
    const request = new Request(href, {
        credentials: 'same-origin'
    });
    const cachedResponse = await cache.match(request);
    if (cachedResponse) return;

    await updateAssetCache(request, cache, route);
}

async function warmNavigationUrl(urlValue) {
    const href = normalizeSameOriginUrl(urlValue);
    if (!href) return;
    const pathname = getRequestPathname(new Request(href));
    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) return;

    if (navigationWarmupTasks.has(href)) {
        await navigationWarmupTasks.get(href);
        return;
    }

    const task = (async () => {
        const cache = await caches.open(getCacheNameForRoute(route, true));
        const request = new Request(href, {
            credentials: 'same-origin',
            headers: {
                Accept: 'text/html'
            }
        });
        const cacheKeyRequest = createNavigationCacheKeyRequest(request);
        const cachedResponse = await cache.match(cacheKeyRequest || request);
        if (cachedResponse) {
            await warmAssetsFromHtmlResponse(cachedResponse.clone(), href);
            return;
        }
        await updateNavigationCache(request, cache, route, true);
    })();

    navigationWarmupTasks.set(href, task);
    try {
        await task;
    } finally {
        navigationWarmupTasks.delete(href);
    }
}

async function warmNavigationUrls(urlValues) {
    for (const urlValue of urlValues) {
        await warmNavigationUrl(urlValue);
    }
}

self.addEventListener('install', (event) => {
    event.waitUntil(warmNavigationUrls(getOfflineFallbackUrls()));
});

async function handleNavigationRequest(request) {
    const pathname = getRequestPathname(request);
    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) {
        return fetch(request);
    }

    const cache = await caches.open(getCacheNameForRoute(route, true));
    const cacheKeyRequest = createNavigationCacheKeyRequest(request);
    const cachedResponse = await cache.match(cacheKeyRequest || request);
    if (cachedResponse) {
        return cachedResponse;
    }

    const networkResponse = await updateNavigationCache(request, cache, route);
    if (networkResponse) {
        return networkResponse;
    }

    const offlineFallbackResponse = await getOfflineFallbackResponse(pathname);
    if (offlineFallbackResponse) {
        return offlineFallbackResponse;
    }

    throw new Error('Navigation request failed with no cached response.');
}

async function handleAssetRequest(request, pathname) {
    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) {
        return fetch(request);
    }

    const cacheName = getCacheNameForRoute(route);
    if (!cacheName) {
        return fetch(request);
    }

    const cache = await caches.open(cacheName);
    const cachedResponse = await cache.match(request);
    if (cachedResponse) {
        return cachedResponse;
    }

    const networkResponse = await updateAssetCache(request, cache, route);
    if (networkResponse) {
        return networkResponse;
    }

    throw new Error('Asset request failed with no network response.');
}

self.addEventListener('activate', (event) => {
    event.waitUntil((async () => {
        if (self.registration.navigationPreload) {
            // Navigation caching is cache-first, so global navigation preload only creates
            // extra network work and Chrome warnings when cached HTML wins.
            await self.registration.navigationPreload.disable();
        }
        const keys = await caches.keys();
        await Promise.all(
            keys
                .filter((key) => shouldDeleteOnActivate(key))
                .map((key) => caches.delete(key))
        );
        await self.clients.claim();
    })());
});

self.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'SKIP_WAITING') {
        self.skipWaiting();
        return;
    }

    if (event.data && event.data.type === 'WARM_NAV_BATCH' && Array.isArray(event.data.urls)) {
        event.waitUntil(warmNavigationUrls(event.data.urls));
    }
});

self.addEventListener('fetch', (event) => {
    const { request } = event;
    const pathname = getRequestPathname(request);
    if (!pathname) return;

    if (isHtmlDocumentRequest(request)) {
        const route = getMatchingRoute(pathname);
        if (!shouldHandleRoute(route)) return;

        event.respondWith(handleNavigationRequest(request));
        return;
    }

    if (!isEligibleAssetRequest(request)) return;

    const route = getMatchingRoute(pathname);
    if (!shouldHandleRoute(route)) return;

    event.respondWith((async () => {
        try {
            return await handleAssetRequest(request, pathname);
        } catch (error) {
            return fetch(request);
        }
    })());
});
